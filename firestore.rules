rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Har user sirf apni scans padh aur likh sakta hai.
    match /users/{uid}/scans/{scanId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Gumnaam bimari ke reports (nakshe ke liye): sab login users padh sakte hain,
    // sirf apna report bana sakte hain, badal ya mita nahi sakte.
    match /outbreaks/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['crop', 'label', 'lat', 'lng', 'uid', 'createdAt'])
        && request.resource.data.lat is number
        && request.resource.data.lng is number;
      allow update, delete: if false;
    }
  }
}
